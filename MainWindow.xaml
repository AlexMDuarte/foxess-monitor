<Window x:Class="FoxESSMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="FoxESS Monitor" Width="374" Height="592" MinWidth="280" MinHeight="430" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Icon="/Assets/foxess.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border CornerRadius="16" BorderBrush="#55FFFFFF" BorderThickness="1" Background="#111927" Padding="18" SnapsToDevicePixels="True" ClipToBounds="True">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Background="Transparent" Cursor="SizeAll" ToolTip="Arraste o cabeçalho para mover" PreviewMouseLeftButtonDown="HeaderDrag"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="10" Background="#263D70" Margin="0,0,9,0" Padding="5"><Image Source="/Assets/foxess.png" Stretch="Uniform"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="FoxESS Monitor" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="H1-3.7-E-G2" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel></StackPanel><Button Grid.Column="1" Content="⚙" Click="SettingsClick" ToolTip="Configuração" Style="{DynamicResource HeaderButton}"/><Button Grid.Column="2" Content="—" Click="MinimizeClick" Style="{DynamicResource HeaderButton}"/></Grid>
   <Border Grid.Row="1" Background="#192633" CornerRadius="17" Padding="17" Margin="0,19,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PRODUÇÃO SOLAR" Foreground="#9BAAC0" FontSize="10" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="PvValue" Text="3.42" FontSize="37" FontWeight="Light" Foreground="White"/><TextBlock Text=" kW" VerticalAlignment="Bottom" Margin="3,0,0,7" FontSize="16" Foreground="#62E6B2"/></StackPanel><TextBlock x:Name="DemoLabel" Text="MODO DEMONSTRAÇÃO" Foreground="#F4C66A" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Width="43" Height="43" CornerRadius="14" Background="#203B36" VerticalAlignment="Center"><TextBlock Text="↗" Foreground="#62E6B2" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
   <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#182330" CornerRadius="13" Padding="12"><StackPanel><TextBlock Text="PV1" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="Pv1Value" Text="1.71 kW" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#182330" CornerRadius="13" Padding="12"><StackPanel><TextBlock Text="PV2" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="Pv2Value" Text="1.71 kW" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></Grid>
   <Grid Grid.Row="3" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="🏠  Casa" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="LoadValue" Grid.Column="1" Text="1.26 kW" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="1" Text="⚡  Rede" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="GridValue" Grid.Row="1" Grid.Column="1" Text="Exportação 2.16 kW" Foreground="#62E6B2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="2" Text="🔋  Bateria" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="SocValue" Grid.Row="2" Grid.Column="1" Text="78%" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="3" Text="📈  Hoje" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="TodayValue" Grid.Row="3" Grid.Column="1" Text="18.7 kWh" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
   <Border Grid.Row="4" Background="#182330" CornerRadius="13" Padding="12" Margin="0,7,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#62E6B2" Margin="0,0,7,0"/><TextBlock x:Name="StatusValue" Text="Inversor online" Foreground="White" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="MetaValue" Text="🌡 31°C   ·   Atualizado agora" Foreground="{StaticResource Muted}" FontSize="9" Margin="14,5,0,0"/><TextBlock x:Name="ErrorValue" Text="" Foreground="#FFAA8A" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="↻" Click="RefreshClick" ToolTip="Atualizar agora" Style="{DynamicResource HeaderButton}"/></Grid></Border>
  </Grid>
 </Border>
 <Window.Resources><Style x:Key="HeaderButton" TargetType="Button"><Setter Property="Foreground" Value="#C5D1E0"/><Setter Property="Background" Value="#202C3C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="31"/><Setter Property="Height" Value="31"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
</Window>
