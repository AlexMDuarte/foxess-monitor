<Window x:Class="FoxESSMonitor.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configuração FoxESS Monitor" Width="410" Height="590" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#111927" Foreground="#F7FAFF">
 <Window.Resources>
  <Style x:Key="ConfigInput" TargetType="Control"><Setter Property="Foreground" Value="#182333"/><Setter Property="Background" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="#A8B5C5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="38"/></Style>
  <Style x:Key="ConfigCheck" TargetType="CheckBox"><Setter Property="Foreground" Value="#F7FAFF"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,5,0,5"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Configuração" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="A chave fica cifrada neste utilizador Windows." Foreground="#B9C7D8" FontSize="11" Margin="0,5,0,15"/></StackPanel>
  <StackPanel Grid.Row="1">
   <TextBlock Text="Endpoint FoxESS"/><TextBox x:Name="EndpointBox" Style="{StaticResource ConfigInput}" Margin="0,5,0,3"/>
   <TextBlock Text="Base da API: https://www.foxesscloud.com. Pode colar o URL completo; o caminho será removido automaticamente." Foreground="#B9C7D8" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,11"/>
   <TextBlock Text="Número de série"/><TextBox x:Name="SerialBox" Style="{StaticResource ConfigInput}" Margin="0,5,0,11"/>
   <TextBlock Text="API key (fica apenas neste PC)"/><PasswordBox x:Name="KeyBox" Style="{StaticResource ConfigInput}" Margin="0,5,0,11"/>
   <TextBlock Text="Atualizar a cada (minutos, mínimo 5)"/><TextBox x:Name="IntervalBox" Style="{StaticResource ConfigInput}" Margin="0,5,0,9"/>
   <CheckBox x:Name="DemoBox" Content="Usar modo demonstração" Style="{StaticResource ConfigCheck}"/>
   <CheckBox x:Name="TopBox" Content="Manter widget sempre no topo" Style="{StaticResource ConfigCheck}"/>
   <CheckBox x:Name="StartupBox" Content="Iniciar com o Windows" Style="{StaticResource ConfigCheck}"/>
   <TextBlock Text="A demo não usa a rede. O teste de ligação faz uma chamada à FoxESS. Registo local (sem API key): %APPDATA%\FoxESS Monitor\FoxESS Monitor.log" TextWrapping="Wrap" Foreground="#B9C7D8" FontSize="10" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Testar ligação" Click="TestClick" Padding="12,8" HorizontalAlignment="Left" Background="#26374B" Foreground="#F7FAFF" BorderBrush="#51647B"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancelar" IsCancel="True" Padding="14,8" Margin="0,0,8,0"/><Button Content="Guardar" IsDefault="True" Click="SaveClick" Padding="17,8" Background="#62E6B2" Foreground="#10201C" BorderThickness="0"/></StackPanel></Grid>
 </Grid>
</Window>
